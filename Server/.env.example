# ---------------------------------------------------------------------------
# SH Digital Studio - API server (Express) environment variables
# Copy to .env and fill in real values. Never commit .env (it is git-ignored).
# Every value below is a placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# MongoDB connection string. The database name is the path segment
# (agency_portfolio). Keep your existing username, password and host.
mongoDbUrl=mongodb+srv://<db-username>:<db-password>@<cluster-host>/agency_portfolio?retryWrites=true&w=majority

# Optional override of the database name in the URI. Leave empty normally;
# the API test suite sets it to agency_portfolio_test.
MONGODB_DB_NAME=

# Secret used to sign admin session tokens (64+ random characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (The legacy spelling JWT_ACCESS_SECRCT is still accepted.)
JWT_ACCESS_SECRET=<long-random-secret>
ADMIN_SESSION_EXPIRES_IN=8h

# Browser origins allowed to call the API (comma separated, no trailing slash).
# Must include the public website, e.g. https://your-domain.com
CLIENT_ORIGINS=http://localhost:3000

# Shared secret between the Next.js server and this API (same value as the
# client's INTERNAL_API_KEY). Generate like JWT_ACCESS_SECRET.
INTERNAL_API_KEY=<long-random-secret>

# Number of proxy hops in front of the API (Vercel = 1). Defaults to 1 in
# production and 0 in development.
TRUST_PROXY=

# Force secure (HTTPS-only) cookies on/off. Defaults to true in production.
COOKIE_SECURE=

# Encrypts client project env variables stored in the admin (Clients -> Env).
# Generate like JWT_ACCESS_SECRET and BACK IT UP: without the same key the
# stored values cannot be read. Use the same value in production.
DATA_ENCRYPTION_KEY=<long-random-secret>

# ---------------------------------------------------------------------------
# First admin account - used once by `npm run seed:admin`, then REMOVE the
# password line. Passwords need 12+ characters with letters and numbers.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=you@your-domain.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=<choose-a-long-passphrase>
# ADMIN_RESET_PASSWORD=false

# ---------------------------------------------------------------------------
# Optional: media uploads to S3 (the media library also works with URLs and
# files in Client/public/media when these are empty). Uploads switch on only
# when ALL of these are set.
# ---------------------------------------------------------------------------
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Public base URL that serves the bucket (bucket URL or CDN), no trailing slash
MEDIA_PUBLIC_BASE_URL=
MEDIA_UPLOAD_PREFIX=sh-digital-studio

# ---------------------------------------------------------------------------
# Optional: e-mail notifications for new inquiries (inquiries are always
# stored in the dashboard; e-mail is only sent when SMTP is configured).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SH Digital Studio <no-reply@your-domain.com>"
# Fallback recipient when no notification address is set in Site settings
INQUIRY_NOTIFY_EMAIL=
