# ---------------------------------------------------------------------------
# SH Digital Studio - Client (Next.js) environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of this website (no trailing slash). Used for canonical URLs,
# the sitemap, Open Graph/social preview images and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Express API (no /api suffix). SERVER-ONLY: used by server
# rendering and by the /api/* proxy route. Never prefix with NEXT_PUBLIC_.
API_ORIGIN=http://localhost:3001

# Shared secret sent by this Next.js server to the API (must match the
# server's INTERNAL_API_KEY). Lets server renders bypass per-IP rate limits
# and forwards the real visitor IP for proxied browser requests.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Optional: extra image hosts that next/image may optimize (comma separated),
# e.g. your S3 / CloudFront media domain.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: Sentry error monitoring (disabled when empty)
NEXT_PUBLIC_SENTRY_DSN=
